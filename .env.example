# Copy to .env.local. Use only the project's public URL and publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Keep VITE_SUPABASE_URL as the original Supabase origin. This is the separate Worker.
VITE_SUPABASE_PROXY_URL=https://saving-app.apexstack-work.workers.dev
# Enable only after SMTP and /account redirect URLs are configured in Supabase.
VITE_AUTH_EMAIL_ENABLED=false
# Enable after applying all workspace migrations, including optional MFA.
VITE_CLOUD_WORKSPACE_ENABLED=false
