# Copy to .env.local. Use only the project's public URL and publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable only after SMTP and /account redirect URLs are configured in Supabase.
VITE_AUTH_EMAIL_ENABLED=false
# Enable only after applying the account workspace migration. Requires TOTP.
VITE_CLOUD_WORKSPACE_ENABLED=false
